  "objectives": [
    {
      "id": "obj.u2.reperer",
      "label": "Repérer le lien familial, le prénom, l’âge et le lieu dans une présentation orale"
    },
    {
      "id": "obj.u2.nommer",
      "label": "Nommer les membres essentiels d’une famille"
    },
    {
      "id": "obj.u2.possessif",
      "label": "Choisir mein/meine et dein/deine selon le nom"
    },
    {
      "id": "obj.u2.haben",
      "label": "Dire ce que l’on a ou n’a pas avec haben et keine"
    },
    {
      "id": "obj.u2.reprendre",
      "label": "Reprendre une personne avec er/sie et accorder le verbe au pluriel"
    },
    {
      "id": "obj.u2.interagir",
      "label": "Présenter plusieurs proches et répondre à des questions simples"
    }
  ],
