    {
      "id": "rem.u1.v2",
      "objectiveId": "obj.u1.question",
      "durationSeconds": 120,
      "explanation": "Dans une question qui commence par un mot interrogatif, le verbe occupe toujours la deuxième place, et le sujet vient juste après lui. C'est la règle la plus rentable de tout le niveau A1 : elle vaut pour woher, wo, wie, wann et was.",
      "contrast": [
        {
          "de": "Woher kommst du?",
          "fr": "D'où viens-tu ?",
          "ok": true
        },
        {
          "de": "Woher du kommst?",
          "fr": "—",
          "ok": false,
          "why": "En français on peut dire « D'où tu viens ? », pas en allemand : le verbe passe devant le sujet."
        }
      ],
