      "objectiveId": "obj.u1.produire",
      "durationSeconds": 110,
      "explanation": "Pour dire d'où l'on vient — un pays, une ville — l'allemand utilise aus : Ich komme aus Kamerun. Ich komme aus Douala. On garde von pour une personne ou un point de départ précis : Ich komme von Anna. Ich komme von der Arbeit.",
      "contrast": [
        {
          "de": "Ich komme aus Kamerun.",
          "fr": "Je viens du Cameroun.",
          "ok": true
        },
        {
          "de": "Ich komme von Kamerun.",
          "fr": "—",
          "ok": false,
          "why": "Kamerun est un pays d'origine, donc aus."
        }
      ],
