{
  "name": "deutschcm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:b2:build": "node scripts/test-baseline/run-p4-5-b2-p1.mjs --flag on -- npm run build",
    "test:e2e:b2": "node scripts/test-baseline/run-p4-5-b2-p1.mjs --flag on -- env PW_FLAG=on PW_TESTMATCH='**/tests/e2e/p4-5-b2b3-b2/!(flag-off).spec.ts' PLAYWRIGHT_PORT=3105 npx playwright test --config=playwright.p4-5-b2.config.ts",
    "test:e2e:b2:flag-off": "node scripts/test-baseline/run-p4-5-b2-p1.mjs --flag off -- env PW_FLAG=off PW_TESTMATCH='**/tests/e2e/p4-5-b2b3-b2/flag-off.spec.ts' PLAYWRIGHT_PORT=3106 npx playwright test --config=playwright.p4-5-b2.config.ts",
    "test:messaging-realtime:p1": "node scripts/test-messaging-realtime-p1.mjs",
    "verify:messaging-realtime:p1": "node scripts/verify-realtime-authorization.mjs",
    "test:messaging-audio:p1": "node scripts/test-baseline/run-p4-5-b2-p1.mjs --flag on -- node scripts/orchestrate-audio-e2e.mjs",
    "test:messaging-audio-ui:p1": "node scripts/test-messaging-audio-ui-p1.mjs",
    "test:messaging-audio-child:p1": "node scripts/test-messaging-audio-child-p1.mjs",
    "capture:messaging-audio:p1": "node scripts/test-baseline/run-p4-5-b2-p1.mjs --flag on -- node scripts/capture-messaging-audio-p1.mjs",
    "test:monde-ivory:p1": "node scripts/test-monde-ivory-p1.mjs",
    "capture:monde-ivory:p1": "node scripts/capture-monde-ivory-p1.mjs",
    "test:monde-context:p1": "node scripts/test-monde-context-p1.mjs",
    "capture:monde-context:p1": "node scripts/capture-monde-context-p1.mjs",
    "test:personas:p1": "node scripts/test-personas-p1.mjs",
    "test:entitlements:p1": "node scripts/test-entitlements-p1.mjs",
    "capture:personas:p1": "node scripts/capture-personas-p1.mjs",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/generative-ai": "latest",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "latest",
    "@remotion/cli": "^4.0.459",
    "@remotion/player": "^4.0.459",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "latest",
    "@types/pg": "^8.20.0",
    "lucide-react": "^1.14.0",
    "music-metadata": "^11.14.0",
    "next": "16.2.6",
    "next-intl": "^4.12.0",
    "openai": "^6.38.0",
    "pg": "^8.20.0",
    "prisma": "latest",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "remotion": "^4.0.459",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
