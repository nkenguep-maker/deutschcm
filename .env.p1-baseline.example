# P-1 Baseline authentifiée — projet Supabase dédié, JAMAIS la production
# Copier ce fichier vers .env.p1-baseline (gitignoré) et remplir les valeurs
# depuis Supabase Dashboard du projet yema-p1-baseline.
# Ref canonique P-1: kzzagbojjkivdzzcrmxn

# Guard : refuser toute exécution si ce marqueur n'est pas "true"
P1_BASELINE_CONFIRMED_NOT_PRODUCTION=true

# Supabase project dedicated to P-1 (yema-p1-baseline)
# Voir scripts/test-baseline/README.md pour comment obtenir les valeurs.
NEXT_PUBLIC_SUPABASE_URL=https://kzzagbojjkivdzzcrmxn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<coller ici l'anon JWT P-1>
SUPABASE_SERVICE_ROLE_KEY=<coller ici le service_role JWT P-1>

# Postgres via pooler Supavisor (IPv4-compatible) — toujours la ref P-1 ci-dessus.
DIRECT_URL=<session pool port 5432 P-1>
DATABASE_URL=<transaction pool port 6543 P-1>

# Mot de passe commun des comptes QA automatisés historiques. Minimum 12 caractères,
# aléatoire, différent de toute valeur Production et jamais commité.
P1_TEST_PASSWORD=<générer 24+ caractères aléatoires>

# Matrice manuelle/canonique 9 personas : 7 adultes avec e-mail distinct +
# 2 enfants SANS e-mail, créés sous P1_PERSONA_FAMILY_EMAIL.
# Ces variables servent uniquement au vérificateur DB en lecture seule.
P1_PERSONA_STUDENT_MONDE_EMAIL=<email QA Élève Monde>
P1_PERSONA_STUDENT_RACINES_EMAIL=<email QA Élève Racines>
P1_PERSONA_FAMILY_EMAIL=<email QA Famille/Parent>
P1_PERSONA_TEACHER_EMAIL=<email QA Enseignant>
P1_PERSONA_COACH_EMAIL=<email QA Coach Racines>
P1_PERSONA_CENTER_EMAIL=<email QA Centre>
P1_PERSONA_ADMIN_EMAIL=<email QA Super Admin déjà attribué par YEMA>

# Secrets QA/runtime optionnels selon le gate exécuté. Garder ces valeurs
# uniquement dans .env.p1-baseline ou dans le coffre de secrets CI P-1.
YEMA_CHILD_SESSION_SECRET=<secret P-1 32+ caractères>

# Notes :
# - Les deux enfants sont retrouvés par parentUserId + universe MONDE/RACINES ; aucun e-mail enfant.
# - Le mot de passe DB est fourni à la création du projet Supabase (à ne pas confondre avec les JWT).
# - Utiliser des secrets DIFFÉRENTS de Production.
# - Ce fichier exemple ne contient aucune valeur secrète réelle.
# - .env.p1-baseline reste local et gitignoré, jamais commité.
